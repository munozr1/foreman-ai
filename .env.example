# Optional; copy to .env to override Compose defaults. No key needed for scripted runs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
FOREMEN_TRACING=0
FOREMEN_PREFIX=foremen/
CDC_STREAM_NAME=foremen
CDC_CURSOR_FILE=/state/cursor.json
FDB_CLUSTER_FILE=/etc/foundationdb/fdb.cluster
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=fdb.cdc.foremen
CH_HOST=clickhouse
CH_PORT=8123
CH_USER=foremen
CH_PASSWORD=local-demo
CH_DATABASE=foremen
